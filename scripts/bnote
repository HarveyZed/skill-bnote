#!/usr/bin/env bash
# bnote 入口包装：解释器可配（BN_PYTHON > config/local.toml > config/default.toml > python3）。
# venv 与 ffmpeg 不随 skill 走 —— 换机器只需指向该机的 python。
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SKILL_ROOT="$(dirname "$HERE")"

_read_python() {  # $1=toml
  [ -f "$1" ] || return 0
  sed -n 's/^[[:space:]]*python[[:space:]]*=[[:space:]]*"\(.*\)".*/\1/p' "$1" | head -1
}

PY="${BN_PYTHON:-}"
PY_SRC="BN_PYTHON 环境变量"
if [ -z "$PY" ]; then PY="$(_read_python "$SKILL_ROOT/config/local.toml")"; PY_SRC="$SKILL_ROOT/config/local.toml"; fi
if [ -z "$PY" ]; then PY="$(_read_python "$SKILL_ROOT/config/default.toml")"; PY_SRC="$SKILL_ROOT/config/default.toml"; fi
if [ -z "$PY" ]; then PY="python3"; PY_SRC="PATH 里的 python3"; fi

# 解释器不可用时给出可行动的提示（而不是 bash 的「没有那个文件或目录」）
if ! command -v "$PY" >/dev/null 2>&1; then
  cat >&2 <<EOF
✗ 找不到 Python 解释器：$PY
  来源：$PY_SRC
  修法（任选）：
    1) bash $SKILL_ROOT/scripts/setup-env.sh        # 建 venv 并装依赖
    2) export BN_PYTHON=/path/to/python             # 临时指定
    3) 在 $SKILL_ROOT/config/local.toml 写：[tools] python = "/path/to/python"
EOF
  exit 127
fi

export PYTHONPATH="$SKILL_ROOT${PYTHONPATH:+:$PYTHONPATH}"
exec "$PY" -m bnote "$@"
